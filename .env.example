# Copie para .env.local (não versionado) e preencha com os dados do seu projeto Supabase.
# A chave abaixo é a PÚBLICA ("anon" ou "publishable"). Nunca use a chave "service_role"/"secret" no jogo.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
# E-mail de contato exibido nos Termos de Uso e na Política de Privacidade
VITE_CONTACT_EMAIL=
# Região do projeto, exibida na Política de Privacidade (ex.: "São Paulo, Brasil (sa-east-1)")
VITE_SUPABASE_REGION_LABEL=
